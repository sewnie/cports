+    follow({ ...session, playbackRate: 1.5 })
+    expect(audio.playbackRate).toBe(1.5)
+
+    act(() => {
+      store.dispatch({ type: PLAYER_CHOOSE_TRACK, data: { id: 'mine' } })
+    })
+
+    expect(audio.playbackRate).toBe(1)
+  })
+
+  it("waits for the leader's next track when a track ends", async () => {
+    mockGetOne.mockResolvedValue({ data: { id: 't2' } })
+    const audio = simulatedAudio({ positionMs: 30000 })
+    setup(audio, 't1')
+    follow()
+
+    // The player clears the current track, then starts the queue over
+    act(() => {
+      audio.emit('ended')
+      store.dispatch({ type: PLAYER_CHOOSE_TRACK, data: {} })
+      store.dispatch({ type: PLAYER_CHOOSE_TRACK, data: { id: 'queued' } })
