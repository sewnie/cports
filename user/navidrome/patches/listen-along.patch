+// adminSessions keeps the sessions of admins and the user's own. Users other than admins
+// only see what admins are playing, as those are the only users they can listen along with.
+func (p *playTracker) adminSessions(ctx context.Context, user model.User, sessions []PlaybackSession) []PlaybackSession {
+	isAdmin := map[string]bool{user.ID: true}
+	return slice.Filter(sessions, func(s PlaybackSession) bool {
+		admin, ok := isAdmin[s.UserId]
+		if !ok {
+			u, err := p.ds.User().Get(ctx, s.UserId)
+			if err != nil {
+				log.Warn(ctx, "Error loading user of now playing session", "userId", s.UserId, err)
+			}
+			admin = err == nil && u.IsAdmin
+			isAdmin[s.UserId] = admin
+		}
+		return admin
+	})
+}
+
 func (p *playTracker) Submit(ctx context.Context, submissions []Submission) error {
 	username, _ := request.UsernameFrom(ctx)
 	player, _ := request.PlayerFrom(ctx)
