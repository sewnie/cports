+    follow()
+    mockGetNowPlaying.mockResolvedValue(nowPlaying([]))
+    await advance(600)
+
+    mockGetNowPlaying.mockResolvedValue(nowPlaying([leaderEntry()]))
+    await act(async () => {
+      store.dispatch({ type: 'nowPlayingCount' })
+      await vi.advanceTimersByTimeAsync(LEADER_GONE_GRACE_MS)
+    })
