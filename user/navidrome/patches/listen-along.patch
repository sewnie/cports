+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'
+import { listenAlongReducer } from './listenAlongReducer'
+import {
+  listenAlongStart,
+  listenAlongStop,
+  listenAlongUpdate,
+} from '../actions'
+
+describe('listenAlongReducer', () => {
+  const initialState = { leader: null, session: null, receivedAt: 0 }
+  const leader = { username: 'admin', playerName: 'NavidromeUI' }
+  const session = { username: 'admin', trackId: 't1', state: 'playing' }
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    vi.setSystemTime(1000)
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+  })
+
+  it('returns the initial state', () => {
+    expect(listenAlongReducer(undefined, {})).toEqual(initialState)
+  })
+
+  it('starts following with the current session', () => {
+    expect(
+      listenAlongReducer(initialState, listenAlongStart(leader, session)),
+    ).toEqual({ leader, session, receivedAt: 1000 })
+  })
+
+  it('stops following', () => {
+    const state = { leader, session, receivedAt: 1000 }
+    expect(listenAlongReducer(state, listenAlongStop())).toEqual(initialState)
+  })
+
+  it("updates the leader's session", () => {
+    const state = { leader, session, receivedAt: 1000 }
+    vi.setSystemTime(5000)
+    const update = { ...session, state: 'paused', positionMs: 4000 }
+    expect(listenAlongReducer(state, listenAlongUpdate(update))).toEqual({
+      leader,
+      session: update,
+      receivedAt: 5000,
+    })
+  })
+
+  it('keeps the time the position was estimated at', () => {
+    const state = { leader, session, receivedAt: 1000 }
+    expect(
+      listenAlongReducer(state, listenAlongUpdate(session, 4500)).receivedAt,
+    ).toBe(4500)
+  })
+
+  it('ignores updates when not following', () => {
+    expect(listenAlongReducer(initialState, listenAlongUpdate(session))).toBe(
+      initialState,
+    )
+  })
+})
