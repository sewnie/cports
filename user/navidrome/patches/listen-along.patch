+++ b/ui/src/reducers/listenAlongReducer.js
@@ -0,0 +1,35 @@
+import {
+  LISTEN_ALONG_START,
+  LISTEN_ALONG_STOP,
+  LISTEN_ALONG_UPDATE,
+} from '../actions'
+
+const initialState = {
+  leader: null,
+  session: null,
+  // Local time the session was received, used to extrapolate the leader's position
+  receivedAt: 0,
+}
+
+export const listenAlongReducer = (previousState = initialState, payload) => {
+  const { type, data } = payload
+  switch (type) {
+    case LISTEN_ALONG_START:
+      return {
+        leader: data.leader,
+        session: data.session,
+        receivedAt: Date.now(),
+      }
+    case LISTEN_ALONG_UPDATE:
+      if (!previousState.leader) return previousState
+      return {
+        ...previousState,
+        session: data.session,
+        receivedAt: data.receivedAt,
+      }
+    case LISTEN_ALONG_STOP:
+      return initialState
+    default:
+      return previousState
+  }
+}
