diff --git a/ui/src/listenAlong/useListenAlongSync.js b/ui/src/listenAlong/useListenAlongSync.js
new file mode 100644
index 00000000..afbf2106
--- /dev/null
+++ b/ui/src/listenAlong/useListenAlongSync.js
@@ -0,0 +1,340 @@
+import { useCallback, useEffect, useRef } from 'react'
+import { useDispatch, useSelector } from 'react-redux'
+import { useDataProvider, useNotify } from 'react-admin'
+import subsonic from '../subsonic'
+import { useInterval } from '../common'
+import {
+  listenAlongStop,
+  listenAlongUpdate,
+  sessionFromNowPlaying,
+  setTrack,
+} from '../actions'
+
+// Listeners may be this far from the leader without being corrected. Correcting means
+// seeking, which interrupts the music, so small drifts are left alone
+export const SYNC_TOLERANCE_MS = 5000
+// When the listener starts playing anyway (joining, the leader resuming), a seek costs
+// nothing audible, so it lines them up more closely
+const START_TOLERANCE_MS = 1000
+// How often a playing listener's drift is checked. This makes no requests
+const DRIFT_CHECK_INTERVAL_MS = 5000
+// Never seek more often than this while playing
+const SEEK_COOLDOWN_MS = 30000
+// Seek events this soon after a seek of ours are its own
+const OWN_SEEK_WINDOW_MS = 1000
+// The player may seek on its own while it loads a track
+const TRACK_LOAD_GRACE_MS = 2000
+// The player moves on by itself when a track ends, before the leader's next one is known
+const TRACK_END_GRACE_MS = 3000
+// A leader is briefly missing from Now Playing between two tracks
+export const LEADER_GONE_GRACE_MS = 15000
+// Now playing updates arrive in bursts, one per playback report
+const FETCH_DEBOUNCE_MS = 500
+
+const isPlayingState = (state) => state === 'playing' || state === 'starting'
+
+// Position the leader is expected to be at now, extrapolated from the last report
+export const expectedPositionMs = (session, receivedAt, now) => {
+  if (!isPlayingState(session.state)) return session.positionMs
+  const rate = session.playbackRate || 1
+  return session.positionMs + (now - receivedAt) * rate
+}
+
+// Picks the leader's entry, preferring the player they were followed on
+export const findLeaderEntry = (entries, leader) => {
+  const own = entries.filter((e) => e.username === leader.username)
+  return own.find((e) => e.playerName === leader.playerName) || own[0]
+}
+
+// useListenAlongSync drives the player to follow the leader's playback, read from the
+// Now Playing list each time a playback report is broadcast. It loads the leader's
+// track and mirrors play/pause changes. Like Spotify's group sessions, it keeps the
+// listener roughly in sync rather than exactly: it never changes the playback speed,
+// and seeks only when the listener starts playing or has drifted further than
+// SYNC_TOLERANCE_MS, at most once per SEEK_COOLDOWN_MS. Nothing here affects the
+// leader's player. A pause by the listener is kept until the leader's state changes;
+// seeking or changing tracks themselves stops following. When a track ends, the
+// listener waits for the leader's next one.
+export const useListenAlongSync = (audioInstance) => {
+  const dispatch = useDispatch()
+  const dataProvider = useDataProvider()
+  const notify = useNotify()
+  const { leader, session, receivedAt } = useSelector(
+    (state) => state.listenAlong,
+  )
+  const currentTrackId = useSelector((state) => state.player.current?.trackId)
+  const lastUpdate = useSelector((state) => state.activity.nowPlayingLastUpdate)
+  const serverStart = useSelector(
+    (state) => state.activity.serverStart.startTime,
+  )
+  const streamReconnected = useSelector(
+    (state) => state.activity.streamReconnected,
+  )
+  const leaderRef = useRef(leader)
+  leaderRef.current = leader
+  // Tracks requested for the leader, to tell them apart from the listener's own choices
+  const requestedTracksRef = useRef(new Set())
+  const loadingTrackRef = useRef(null)
+  const appliedStateRef = useRef(null)
+  const ownSeekUntilRef = useRef(0)
+  const lastSeekAtRef = useRef(0)
+  const rateChangedRef = useRef(false)
+  const trackLoadedAtRef = useRef(0)
+  const lastTimeRef = useRef(0)
+  const missingSinceRef = useRef(null)
+  const recheckTimerRef = useRef(null)
+  const holdPausedUntilRef = useRef(0)
+  const endedAtRef = useRef(0)
+
+  const stopFollowing = useCallback(
+    (message) => {
+      const following = leaderRef.current
+      if (!following) return
+      dispatch(listenAlongStop())
+      notify(message, 'info', { username: following.username })
+    },
+    [dispatch, notify],
+  )
+
+  const syncSeek = useCallback(
+    (positionMs) => {
+      const now = Date.now()
+      ownSeekUntilRef.current = now + OWN_SEEK_WINDOW_MS
+      lastSeekAtRef.current = now
+      audioInstance.currentTime = Math.max(0, positionMs) / 1000
+    },
+    [audioInstance],
+  )
+
+  const refreshRef = useRef()
+  refreshRef.current = () => {
+    const following = leaderRef.current
+    if (!following) return
+    const requestedAt = Date.now()
+    // The server leaves out sessions the user cannot follow, such as a demoted admin's
+    subsonic
+      .getNowPlaying()
+      .then((resp) => resp.json['subsonic-response'])
+      .then((data) => {
+        if (leaderRef.current !== following || data.status !== 'ok') return
+        const entry = findLeaderEntry(data.nowPlaying?.entry || [], following)
+        const now = Date.now()
+        if (entry) {
+          missingSinceRef.current = null
+          // The server estimates the position while handling the request, about
+          // halfway through it
+          dispatch(
+            listenAlongUpdate(
+              sessionFromNowPlaying(entry),
+              (requestedAt + now) / 2,
+            ),
+          )
+          return
+        }
+        if (missingSinceRef.current === null) missingSinceRef.current = now
+        const missingFor = now - missingSinceRef.current
+        if (missingFor >= LEADER_GONE_GRACE_MS) {
+          stopFollowing('listenAlong.ended')
+          return
+        }
+        clearTimeout(recheckTimerRef.current)
+        recheckTimerRef.current = setTimeout(
+          () => refreshRef.current(),
+          LEADER_GONE_GRACE_MS - missingFor,
+        )
+      })
+      .catch(() => {})
+  }
+
+  useEffect(() => {
+    if (!leader || !serverStart) return
+    const timer = setTimeout(() => refreshRef.current(), FETCH_DEBOUNCE_MS)
+    return () => clearTimeout(timer)
+  }, [leader, lastUpdate, serverStart, streamReconnected])
+
+  useEffect(() => {
+    if (leader) return
+    requestedTracksRef.current.clear()
+    loadingTrackRef.current = null
+    appliedStateRef.current = null
+    missingSinceRef.current = null
+    holdPausedUntilRef.current = 0
+    clearTimeout(recheckTimerRef.current)
+    if (audioInstance && rateChangedRef.current) audioInstance.playbackRate = 1
+    rateChangedRef.current = false
+  }, [leader, audioInstance])
+
+  useEffect(() => () => clearTimeout(recheckTimerRef.current), [])
+
+  // Changing tracks stops following, unless the track is the leader's or the
+  // player moved on at the end of a track
+  const prevTrackRef = useRef(currentTrackId)
+  useEffect(() => {
+    const prev = prevTrackRef.current
+    prevTrackRef.current = currentTrackId
+    if (!leader || !currentTrackId || prev === currentTrackId) return
+    if (requestedTracksRef.current.has(currentTrackId)) return
+    if (Date.now() - endedAtRef.current < TRACK_END_GRACE_MS) return
+    stopFollowing('listenAlong.left')
+  }, [leader, currentTrackId, stopFollowing])
+
+  // Seeking stops following, except for the seeks this hook and the player make.
+  // Also keeps the player from starting its own queue over while waiting for the
+  // leader's next track
+  useEffect(() => {
+    if (!audioInstance) return
+    const onLoadStart = () => {
+      trackLoadedAtRef.current = Date.now()
+    }
+    const onTimeUpdate = () => {
+      lastTimeRef.current = audioInstance.currentTime
+    }
+    const onSeeking = () => {
+      if (!leaderRef.current) return
+      const now = Date.now()
+      if (now < ownSeekUntilRef.current) return
+      if (now - trackLoadedAtRef.current < TRACK_LOAD_GRACE_MS) return
+      // Repeating the track seeks back to its start
+      if (lastTimeRef.current >= (audioInstance.duration || Infinity) - 1) {
+        return
+      }
+      stopFollowing('listenAlong.left')
+    }
+    const onPlay = () => {
+      if (leaderRef.current && Date.now() < holdPausedUntilRef.current) {
+        audioInstance.pause()
+      }
+    }
+    // Wait for the leader's next track, which also replaces whatever the player
+    // moves on to
+    const onEnded = () => {
+      if (!leaderRef.current) return
+      const now = Date.now()
+      endedAtRef.current = now
+      holdPausedUntilRef.current = now + LEADER_GONE_GRACE_MS
+      appliedStateRef.current = null
+    }
+    const events = {
+      loadstart: onLoadStart,
+      timeupdate: onTimeUpdate,
+      seeking: onSeeking,
+      play: onPlay,
+      ended: onEnded,
+    }
+    Object.entries(events).forEach(([name, fn]) =>
+      audioInstance.addEventListener(name, fn),
+    )
+    return () =>
+      Object.entries(events).forEach(([name, fn]) =>
+        audioInstance.removeEventListener(name, fn),
+      )
+  }, [audioInstance, stopFollowing])
+
+  // Loads the leader's track and mirrors their play/pause changes
+  useEffect(() => {
+    if (!leader || !session || !audioInstance) return
+
+    if (session.trackId !== currentTrackId) {
+      if (loadingTrackRef.current === session.trackId) return
+      loadingTrackRef.current = session.trackId
+      requestedTracksRef.current.add(session.trackId)
+      holdPausedUntilRef.current = 0
+      dataProvider
+        .getOne('song', { id: session.trackId })
+        .then(({ data }) => dispatch(setTrack(data)))
+        .catch(() => {
+          loadingTrackRef.current = null
+          notify('listenAlong.trackUnavailable', 'warning')
+        })
+      return
+    }
+    loadingTrackRef.current = null
+
+    const apply = () => {
+      const playing = isPlayingState(session.state)
+      const targetMs = expectedPositionMs(session, receivedAt, Date.now())
+      // A report from just before the leader's track ended: wait for their next one
+      if (
+        playing &&
+        audioInstance.duration &&
+        targetMs >= audioInstance.duration * 1000 - START_TOLERANCE_MS
+      ) {
+        return
+      }
+      const stateKey = `${session.trackId}:${session.state}`
+      const stateChanged = appliedStateRef.current !== stateKey
+      appliedStateRef.current = stateKey
+      if (!stateChanged) return
+
+      if (!playing) {
+        // Pausing leaves the listener close enough. Seeking would make the player
+        // resume, so the position is fixed when the leader plays again
+        audioInstance.pause()
+        return
+      }
+      holdPausedUntilRef.current = 0
+      const driftMs = audioInstance.currentTime * 1000 - targetMs
+      const tolerance = audioInstance.paused
+        ? START_TOLERANCE_MS
+        : SYNC_TOLERANCE_MS
+      if (Math.abs(driftMs) > tolerance) syncSeek(targetMs)
+      const rate = session.playbackRate || 1
+      if (audioInstance.playbackRate !== rate) {
+        audioInstance.playbackRate = rate
+        rateChangedRef.current = true
+      }
+      if (audioInstance.paused) audioInstance.play().catch(() => {})
+    }
+
+    // Seeking needs the track's metadata, which may still be loading
+    if (audioInstance.readyState >= 1) {
+      apply()
+      return
+    }
+    audioInstance.addEventListener('loadedmetadata', apply, { once: true })
+    return () => audioInstance.removeEventListener('loadedmetadata', apply)
+  }, [
+    leader,
+    session,
+    receivedAt,
+    currentTrackId,
+    audioInstance,
+    dataProvider,
+    dispatch,
+    notify,
+    syncSeek,
+  ])
+
+  // Brings back a playing listener who drifted far from a playing leader, such as
+  // after buffering
+  useInterval(
+    () => {
+      if (
+        !session ||
+        !isPlayingState(session.state) ||
+        session.trackId !== currentTrackId ||
+        audioInstance.paused ||
+        audioInstance.seeking ||
+        audioInstance.readyState < 3
+      ) {
+        return
+      }
+      const now = Date.now()
+      if (now - lastSeekAtRef.current < SEEK_COOLDOWN_MS) return
+      const targetMs = expectedPositionMs(session, receivedAt, now)
+      if (
+        audioInstance.duration &&
+        targetMs >= audioInstance.duration * 1000 - SYNC_TOLERANCE_MS
+      ) {
+        return
+      }
+      if (
+        Math.abs(audioInstance.currentTime * 1000 - targetMs) >
+        SYNC_TOLERANCE_MS
+      ) {
+        syncSeek(targetMs)
+      }
+    },
+    leader && audioInstance ? DRIFT_CHECK_INTERVAL_MS : null,
+  )
+}
diff --git a/ui/src/listenAlong/useListenAlongSync.test.jsx b/ui/src/listenAlong/useListenAlongSync.test.jsx
new file mode 100644
index 00000000..5bf05149
--- /dev/null
+++ b/ui/src/listenAlong/useListenAlongSync.test.jsx
@@ -0,0 +1,521 @@
+import React from 'react'
+import { renderHook, act } from '@testing-library/react-hooks'
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'
+import { Provider } from 'react-redux'
+import { createStore, combineReducers } from 'redux'
+import { listenAlongReducer } from '../reducers/listenAlongReducer'
+import {
+  PLAYER_SET_TRACK,
+  listenAlongStart,
+  listenAlongUpdate,
+} from '../actions'
+import {
+  LEADER_GONE_GRACE_MS,
+  SYNC_TOLERANCE_MS,
+  expectedPositionMs,
+  findLeaderEntry,
+  useListenAlongSync,
+} from './useListenAlongSync'
+
+const mockGetOne = vi.fn()
+const mockNotify = vi.fn()
+const mockGetNowPlaying = vi.fn()
+
+vi.mock('react-admin', () => ({
+  useDataProvider: () => ({ getOne: mockGetOne }),
+  useNotify: () => mockNotify,
+}))
+
+vi.mock('../subsonic', () => ({
+  default: { getNowPlaying: () => mockGetNowPlaying() },
+}))
+
+// An audio element whose position advances with the (fake) clock. Seeks take
+// seekDelayMs to resume playback, like a real stream does.
+const simulatedAudio = ({
+  positionMs = 0,
+  paused = false,
+  seekDelayMs = 0,
+}) => {
+  const listeners = {}
+  let base = positionMs
+  let baseAt = Date.now()
+  let rate = 1
+  let resumeAt = 0
+  let isPaused = paused
+  const position = () => {
+    const now = Date.now()
+    if (isPaused || now < resumeAt) return base
+    return base + (now - Math.max(baseAt, resumeAt)) * rate
+  }
+  const rebase = () => {
+    base = position()
+    baseAt = Math.max(Date.now(), resumeAt)
+  }
+  const audio = {
+    readyState: 4,
+    duration: 300,
+    seeks: 0,
+    get seeking() {
+      return Date.now() < resumeAt
+    },
+    get paused() {
+      return isPaused
+    },
+    get currentTime() {
+      return position() / 1000
+    },
+    set currentTime(seconds) {
+      audio.seeks++
+      base = seconds * 1000
+      resumeAt = Date.now() + seekDelayMs
+      baseAt = resumeAt
+      audio.emit('seeking')
+    },
+    get playbackRate() {
+      return rate
+    },
+    set playbackRate(value) {
+      rebase()
+      rate = value
+    },
+    play: vi.fn(() => {
+      rebase()
+      isPaused = false
+      audio.emit('play')
+      return Promise.resolve()
+    }),
+    pause: vi.fn(() => {
+      rebase()
+      isPaused = true
+    }),
+    addEventListener: vi.fn((name, fn) => {
+      listeners[name] = [...(listeners[name] || []), fn]
+    }),
+    removeEventListener: vi.fn((name, fn) => {
+      listeners[name] = (listeners[name] || []).filter((l) => l !== fn)
+    }),
+    emit: (name) => (listeners[name] || []).forEach((fn) => fn()),
+  }
+  return audio
+}
+
+describe('expectedPositionMs', () => {
+  it('extrapolates a playing session', () => {
+    const session = { state: 'playing', positionMs: 1000, playbackRate: 1.5 }
+    expect(expectedPositionMs(session, 0, 2000)).toBe(4000)
+  })
+
+  it('keeps the position of a paused session', () => {
+    const session = { state: 'paused', positionMs: 1000, playbackRate: 1 }
+    expect(expectedPositionMs(session, 0, 2000)).toBe(1000)
+  })
+})
+
+describe('findLeaderEntry', () => {
+  const leader = { username: 'admin', playerName: 'Web' }
+
+  it('prefers the player the leader was followed on', () => {
+    const entries = [
+      { username: 'admin', playerName: 'Phone' },
+      { username: 'admin', playerName: 'Web' },
+    ]
+    expect(findLeaderEntry(entries, leader)).toBe(entries[1])
+  })
+
+  it('falls back to another player of the leader', () => {
+    const entries = [
+      { username: 'bob', playerName: 'Web' },
+      { username: 'admin', playerName: 'Phone' },
+    ]
+    expect(findLeaderEntry(entries, leader)).toBe(entries[1])
+  })
+
+  it('returns nothing when the leader is not playing', () => {
+    expect(findLeaderEntry([{ username: 'bob' }], leader)).toBeUndefined()
+  })
+})
+
+describe('useListenAlongSync', () => {
+  let store
+  let actions
+  const leader = { username: 'admin', playerName: 'Web' }
+  const session = {
+    username: 'admin',
+    trackId: 't1',
+    state: 'playing',
+    positionMs: 30000,
+    playbackRate: 1,
+  }
+
+  const nowPlaying = (entry) => ({
+    json: { 'subsonic-response': { status: 'ok', nowPlaying: { entry } } },
+  })
+
+  const leaderEntry = (overrides = {}) => ({
+    username: 'admin',
+    playerName: 'Web',
+    id: 't1',
+    state: 'playing',
+    positionMs: 30000,
+    playbackRate: 1,
+    ...overrides,
+  })
+
+  const PLAYER_CHOOSE_TRACK = 'TEST_CHOOSE_TRACK'
+
+  const setup = (audio, currentTrackId) => {
+    actions = []
+    const player = (state = { current: { trackId: currentTrackId } }, a) => {
+      if (a.type === PLAYER_SET_TRACK || a.type === PLAYER_CHOOSE_TRACK) {
+        return { current: { trackId: a.data.id } }
+      }
+      return state
+    }
+    store = createStore(
+      combineReducers({
+        listenAlong: listenAlongReducer,
+        player,
+        activity: (
+          state = {
+            serverStart: { startTime: 1 },
+            streamReconnected: 0,
+            nowPlayingLastUpdate: 0,
+          },
+          a,
+        ) =>
+          a.type === 'nowPlayingCount'
+            ? { ...state, nowPlayingLastUpdate: state.nowPlayingLastUpdate + 1 }
+            : state,
+      }),
+    )
+    const dispatch = store.dispatch
+    store.dispatch = (a) => {
+      actions.push(a)
+      return dispatch(a)
+    }
+    const wrapper = ({ children }) => (
+      <Provider store={store}>{children}</Provider>
+    )
+    return renderHook(() => useListenAlongSync(audio), { wrapper })
+  }
+
+  const follow = (s = session) =>
+    act(() => {
+      store.dispatch(listenAlongStart(leader, s))
+    })
+
+  const advance = (ms) =>
+    act(async () => {
+      await vi.advanceTimersByTimeAsync(ms)
+    })
+
+  // The leader plays from 30000ms when the test starts, moved by leaderOffsetMs
+  let leaderOffsetMs
+  const leaderPositionMs = () => Date.now() - 70000 + leaderOffsetMs
+
+  // Moves the leader back so a listener in sync is ms ahead of them
+  const aheadBy = (ms) =>
+    act(() => {
+      leaderOffsetMs = -ms
+      store.dispatch(
+        listenAlongUpdate(
+          { ...session, positionMs: leaderPositionMs() },
+          Date.now(),
+        ),
+      )
+    })
+
+  // Drift of the listener from where the leader is now, in ms
+  const drift = (audio) => {
+    const { session: s, receivedAt } = store.getState().listenAlong
+    return (
+      audio.currentTime * 1000 - expectedPositionMs(s, receivedAt, Date.now())
+    )
+  }
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    vi.setSystemTime(100000)
+    vi.clearAllMocks()
+    leaderOffsetMs = 0
+    // Like the server, estimate where the leader is when asked
+    mockGetNowPlaying.mockImplementation(() =>
+      Promise.resolve(
+        nowPlaying([leaderEntry({ positionMs: leaderPositionMs() })]),
+      ),
+    )
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+  })
+
+  it("loads the leader's track when a different one is playing", async () => {
+    mockGetOne.mockResolvedValue({ data: { id: 't1', title: 'Song' } })
+    setup(simulatedAudio({}), 'other')
+
+    await act(async () => {
+      store.dispatch(listenAlongStart(leader, session))
+    })
+
+    expect(mockGetOne).toHaveBeenCalledWith('song', { id: 't1' })
+    expect(actions.some((a) => a.type === PLAYER_SET_TRACK)).toBe(true)
+    expect(store.getState().listenAlong.leader).toEqual(leader)
+  })
+
+  it("seeks to the leader's position and resumes playback", () => {
+    const audio = simulatedAudio({ paused: true })
+    setup(audio, 't1')
+    follow()
+
+    expect(audio.currentTime).toBe(30)
+    expect(audio.play).toHaveBeenCalled()
+  })
+
+  it('leaves drifts within the tolerance alone', async () => {
+    const audio = simulatedAudio({ positionMs: 30000 })
+    setup(audio, 't1')
+    follow()
+    aheadBy(SYNC_TOLERANCE_MS - 500)
+
+    await advance(60000)
+
+    expect(audio.seeks).toBe(0)
+    expect(audio.playbackRate).toBe(1)
+    expect(audio.pause).not.toHaveBeenCalled()
+  })
+
+  it('seeks back to the leader when drifting too far, at most once in a while', async () => {
+    const audio = simulatedAudio({ positionMs: 30000, seekDelayMs: 800 })
+    setup(audio, 't1')
+    follow()
+    await advance(6000)
+    aheadBy(SYNC_TOLERANCE_MS + 1000)
+
+    await advance(6000)
+    expect(audio.seeks).toBe(1)
+    expect(Math.abs(drift(audio))).toBeLessThan(SYNC_TOLERANCE_MS)
+
+    // The leader moves back again, too soon for another seek
+    aheadBy(2 * (SYNC_TOLERANCE_MS + 1000))
+    await advance(6000)
+    expect(audio.seeks).toBe(1)
+    await advance(30000)
+    expect(audio.seeks).toBe(2)
+    expect(audio.playbackRate).toBe(1)
+  })
+
+  it('lines up closely when joining', () => {
+    const audio = simulatedAudio({ positionMs: 27000, paused: true })
+    setup(audio, 't1')
+    follow()
+
+    expect(audio.currentTime).toBe(30)
+  })
+
+  it('does not seek on repeated reports of the same state', () => {
+    const audio = simulatedAudio({ positionMs: 30000 })
+    setup(audio, 't1')
+    follow()
+    aheadBy(3000)
+    aheadBy(4000)
+
+    expect(audio.seeks).toBe(0)
+    expect(audio.play).not.toHaveBeenCalled()
+  })
+
+  it('pauses when the leader pauses', () => {
+    const audio = simulatedAudio({ positionMs: 30000 })
+    setup(audio, 't1')
+    follow()
+
+    act(() => {
+      store.dispatch(
+        listenAlongUpdate({ ...session, state: 'paused', positionMs: 31000 }),
+      )
+    })
+
+    expect(audio.pause).toHaveBeenCalled()
+    expect(audio.seeks).toBe(0)
+  })
+
+  it("catches up with the leader's moves while paused when they resume", () => {
