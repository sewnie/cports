--- /dev/null
+++ b/ui/src/actions/listenAlong.js
@@ -0,0 +1,29 @@
+export const LISTEN_ALONG_START = 'LISTEN_ALONG_START'
+export const LISTEN_ALONG_UPDATE = 'LISTEN_ALONG_UPDATE'
+export const LISTEN_ALONG_STOP = 'LISTEN_ALONG_STOP'
+
+// leader is { username, playerName }; session is the leader's current playback
+export const listenAlongStart = (leader, session) => ({
+  type: LISTEN_ALONG_START,
+  data: { leader, session },
+})
+
+// receivedAt is the local time the session's position was estimated at
+export const listenAlongUpdate = (session, receivedAt = Date.now()) => ({
+  type: LISTEN_ALONG_UPDATE,
+  data: { session, receivedAt },
+})
+
+export const listenAlongStop = () => ({
+  type: LISTEN_ALONG_STOP,
+})
+
+// Builds the leader's session from a Subsonic getNowPlaying entry
+export const sessionFromNowPlaying = (entry) => ({
+  username: entry.username,
+  playerName: entry.playerName,
+  trackId: entry.id,
+  state: entry.state,
+  positionMs: entry.positionMs || 0,
+  playbackRate: entry.playbackRate || 1,
+})
