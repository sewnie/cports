@@ -0,0 +1,80 @@
+package scrobbler
+
+import (
+	"context"
+
+	"github.com/navidrome/navidrome/conf/configtest"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("GetNowPlaying visibility", func() {
+	var ds *tests.MockDataStore
+	var tracker *playTracker
+	var admin, alice, bob model.User
+
+	userCtx := func(u model.User) context.Context {
+		ctx := request.WithUser(GinkgoT().Context(), u)
+		return request.WithPlayer(ctx, model.Player{ScrobbleEnabled: true})
+	}
+
+	play := func(u model.User) {
+		Expect(tracker.ReportPlayback(userCtx(u), ReportPlaybackParams{
+			MediaId:      "123",
+			PositionMs:   1000,
+			State:        StatePlaying,
+			PlaybackRate: 1,
+			ClientId:     u.ID + "-client",
+			ClientName:   "Player",
+		})).To(Succeed())
+	}
+
+	usernames := func(u model.User) []string {
+		sessions, err := tracker.GetNowPlaying(userCtx(u))
+		Expect(err).ToNot(HaveOccurred())
+		var res []string
+		for _, s := range sessions {
+			res = append(res, s.Username)
+		}
+		return res
+	}
+
+	BeforeEach(func() {
+		DeferCleanup(configtest.SetupConfig())
+		ds = &tests.MockDataStore{}
+		tracker = newPlayTracker(ds, &fakeEventBroker{}, nil)
+		DeferCleanup(tracker.stopBackgroundWorkers)
+
+		libs := model.Libraries{{ID: 1}}
+		admin = model.User{ID: "u-admin", UserName: "admin", IsAdmin: true, Libraries: libs}
+		alice = model.User{ID: "u-alice", UserName: "alice", Libraries: libs}
+		bob = model.User{ID: "u-bob", UserName: "bob", Libraries: libs}
+		for _, u := range []*model.User{&admin, &alice, &bob} {
+			Expect(ds.User().Put(GinkgoT().Context(), u)).To(Succeed())
+		}
+
+		track := model.MediaFile{ID: "123", LibraryID: 1, Title: "Track Title"}
+		Expect(ds.MediaFile().Put(GinkgoT().Context(), &track)).To(Succeed())
+
+		play(admin)
+		play(alice)
+		play(bob)
+	})
+
+	It("shows admins every session", func() {
+		Expect(usernames(admin)).To(ConsistOf("admin", "alice", "bob"))
+	})
+
+	It("shows other users only the sessions of admins and their own", func() {
+		Expect(usernames(alice)).To(ConsistOf("admin", "alice"))
+	})
+
+	It("hides sessions of a demoted admin", func() {
+		admin.IsAdmin = false
+		Expect(ds.User().Put(GinkgoT().Context(), &admin)).To(Succeed())
+		Expect(usernames(alice)).To(ConsistOf("alice"))
+	})
+})
